@model LibrarySystem.Application.Features.Books.Dtos.BookDto
@using LibrarySystem.Application.Features.Rentals.Dtos
@using LibrarySystem.Application.Features.RentalRequests.Dtos
@using LibrarySystem.Domain.Enums
@{
    ViewData["Title"] = "Book Details";
    var rentals = ViewBag.Rentals as List<RentalTransactionDto> ?? new List<RentalTransactionDto>();
    var rentalRequests = ViewBag.RentalRequests as List<RentalRequestDto> ?? new List<RentalRequestDto>();
}
<div class="page-header">
    <h1 class="page-title">Book Details</h1>
</div>
<div class="form-card">
    <dl class="row">
    <dt class="col-sm-2">Title</dt>
    <dd class="col-sm-10">@Model.Title</dd>
    <dt class="col-sm-2">Author</dt>
    <dd class="col-sm-10">@Model.Author</dd>
    <dt class="col-sm-2">Genre</dt>
    <dd class="col-sm-10">@Model.Genre</dd>
    <dt class="col-sm-2">Pledge Value</dt>
    <dd class="col-sm-10">@Model.PledgeValue.ToString("C")</dd>
    <dt class="col-sm-2">Base Rental Cost</dt>
    <dd class="col-sm-10">@Model.BaseRentalCost.ToString("C")</dd>
    <dt class="col-sm-2">Total Copies</dt>
    <dd class="col-sm-10">@Model.TotalCount</dd>
    <dt class="col-sm-2">Available</dt>
    <dd class="col-sm-10">
        <span class="badge @(Model.AvailableCount > 0 ? "bg-success" : "bg-danger")">@Model.AvailableCount</span>
    </dd>
    <dt class="col-sm-2">In Rent</dt>
    <dd class="col-sm-10">@Model.InRentCount</dd>
    </dl>
    <div class="d-flex gap-2 mt-4">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
        <a asp-action="Index" class="btn btn-outline-primary">Back to List</a>
    </div>
</div>
@if (User.IsInRole("Admin") && rentals.Any())
{
    <div class="form-card mt-4">
        <h5 class="section-title mb-3">Rental History</h5>
        <div class="table-responsive">
            <table class="table table-modern mb-0">
                <thead>
                    <tr>
                        <th>Reader</th>
                        <th>Issue Date</th>
                        <th>Expected Return</th>
                        <th>Actual Return</th>
                        <th>Status</th>
                        <th>Final Cost</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rental in rentals)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(rental.ReaderName))
                                {
                                    <a asp-area="Admin" asp-controller="Readers" asp-action="Details" asp-route-id="@rental.ReaderId">@rental.ReaderName</a>
                                }
                                else
                                {
                                    <span>N/A</span>
                                }
                            </td>
                            <td>@rental.IssueDate.ToShortDateString()</td>
                            <td>@rental.ExpectedReturnDate.ToShortDateString()</td>
                            <td>@(rental.ActualReturnDate?.ToShortDateString() ?? "-")</td>
                            <td>
                                <span class="badge @(rental.Status == RentalStatus.Active ? "bg-success" : "bg-secondary")">@rental.Status</span>
                            </td>
                            <td>@rental.FinalRentalCost.ToString("C")</td>
                            <td>
                                <a asp-area="Admin" asp-controller="Rentals" asp-action="Details" asp-route-id="@rental.Id" class="btn btn-sm btn-secondary">Details</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
@if (User.IsInRole("Admin") && rentalRequests.Any())
{
    <div class="form-card mt-4">
        <h5 class="section-title mb-3">Rental Requests</h5>
        <div class="table-responsive">
            <table class="table table-modern mb-0">
                <thead>
                    <tr>
                        <th>Reader</th>
                        <th>Request Date</th>
                        <th>Status</th>
                        <th>Expected Return Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in rentalRequests)
                    {
                        <tr>
                            <td>
                                <a asp-area="Admin" asp-controller="Readers" asp-action="Details" asp-route-id="@request.ReaderId">@request.ReaderName</a>
                            </td>
                            <td>@request.RequestDate.ToShortDateString()</td>
                            <td>
                                @if (request.Status == RentalRequestStatus.Pending)
                                {
                                    <span class="badge bg-warning">Pending</span>
                                }
                                else if (request.Status == RentalRequestStatus.Approved)
                                {
                                    <span class="badge bg-success">Approved</span>
                                }
                                else if (request.Status == RentalRequestStatus.Denied)
                                {
                                    <span class="badge bg-danger">Denied</span>
                                }
                            </td>
                            <td>@(request.ExpectedReturnDate?.ToShortDateString() ?? "-")</td>
                            <td>
                                <a asp-area="Admin" asp-controller="RentalRequests" asp-action="Details" asp-route-id="@request.Id" class="btn btn-sm btn-secondary">Details</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}