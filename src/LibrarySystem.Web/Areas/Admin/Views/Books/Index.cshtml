@model IEnumerable<LibrarySystem.Application.Features.Books.Dtos.BookDto>
@{
    ViewData["Title"] = "Books";
}
<div class="page-header">
    <div>
        <h1 class="page-title">Books</h1>
        <p class="page-subtitle">Manage your library catalog</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Create Book</a>
</div>
@if (TempData["Error"] is string errorMessage)
{
    <div class="alert alert-danger mb-3">@errorMessage</div>
}
<div class="card-elevated p-3 mb-3">
    <form id="searchForm" class="mb-0">
        <div class="row g-2">
            <div class="col-md-10">
                <input type="text" id="searchInput" class="form-control" placeholder="Search by title, author, or genre..." />
            </div>
            <div class="col-md-2">
                <button type="button" id="clearSearch" class="btn btn-outline-secondary w-100" style="display: none;">Clear</button>
            </div>
        </div>
    </form>
</div>
<div class="table-list" id="booksTable">
    <div class="table-list-header">
        <div>Title</div>
        <div>Author</div>
        <div>Genre</div>
        <div>Pledge Value</div>
        <div>Base Rental Cost (per day)</div>
        <div class="table-list-cell--actions">Actions</div>
    </div>
    <div id="booksContainer">
        @foreach (var book in Model)
        {
            <div class="table-list-row">
                <div class="table-list-cell" data-label="Title">@book.Title</div>
                <div class="table-list-cell" data-label="Author">@book.Author</div>
                <div class="table-list-cell" data-label="Genre">
                    <span class="badge bg-secondary">@book.Genre</span>
                </div>
                <div class="table-list-cell" data-label="Pledge Value">@book.PledgeValue.ToString("C")</div>
                <div class="table-list-cell" data-label="Base Rental Cost">@book.BaseRentalCost.ToString("C")</div>
                <div class="table-list-cell table-list-cell--actions" data-label="Actions">
                    <a asp-action="Details" asp-route-id="@book.Id" class="btn btn-sm btn-secondary">Details</a>
                    <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-primary">Edit</a>
                    <form asp-action="Delete" asp-route-id="@book.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this book?');">Delete</button>
                    </form>
                </div>
            </div>
        }
    </div>
    <div id="loadingIndicator" class="text-center p-4" style="display: none;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
</div>
@section Scripts {
    @Html.AntiForgeryToken()
    <script>
        (function() {
            let currentPage = 1;
            let isLoading = false;
            let hasMorePages = true;
            let currentSearch = '';
            const pageSize = 20;
            const container = document.getElementById('booksContainer');
            const searchInput = document.getElementById('searchInput');
            const clearBtn = document.getElementById('clearSearch');
            const loadingIndicator = document.getElementById('loadingIndicator');
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            let searchTimeout;
            searchInput.addEventListener('input', function() {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(() => {
                    currentSearch = this.value.trim();
                    currentPage = 1;
                    hasMorePages = true;
                    container.innerHTML = '';
                    clearBtn.style.display = currentSearch ? 'block' : 'none';
                    loadBooks();
                }, 500);
            });
            clearBtn.addEventListener('click', function() {
                searchInput.value = '';
                currentSearch = '';
                currentPage = 1;
                hasMorePages = true;
                container.innerHTML = '';
                this.style.display = 'none';
                loadBooks();
            });
            function loadBooks() {
                if (isLoading || !hasMorePages) return;
                isLoading = true;
                loadingIndicator.style.display = 'block';
                const baseUrl = '@Url.Action("GetBooks", "Books", new { area = "Admin" })';
                const url = baseUrl + `?search=${encodeURIComponent(currentSearch)}&pageNumber=${currentPage}&pageSize=${pageSize}`;
                fetch(url)
                    .then(response => response.json())
                    .then(data => {
                        if (data.items && data.items.length > 0) {
                            data.items.forEach(book => {
                                const row = document.createElement('div');
                                row.className = 'table-list-row';
                                const detailsUrl = '@Url.Action("Details", "Books", new { area = "Admin" })/' + book.id;
                                const editUrl = '@Url.Action("Edit", "Books", new { area = "Admin" })/' + book.id;
                                const deleteUrl = '@Url.Action("Delete", "Books", new { area = "Admin" })/' + book.id;
                                row.innerHTML = `
                                    <div class="table-list-cell" data-label="Title">${escapeHtml(book.title)}</div>
                                    <div class="table-list-cell" data-label="Author">${escapeHtml(book.author)}</div>
                                    <div class="table-list-cell" data-label="Genre">
                                        <span class="badge bg-secondary">${escapeHtml(book.genre)}</span>
                                    </div>
                                    <div class="table-list-cell" data-label="Pledge Value">${formatCurrency(book.pledgeValue)}</div>
                                    <div class="table-list-cell" data-label="Base Rental Cost">${formatCurrency(book.baseRentalCost)}</div>
                                    <div class="table-list-cell table-list-cell--actions" data-label="Actions">
                                        <a href="${detailsUrl}" class="btn btn-sm btn-secondary">Details</a>
                                        <a href="${editUrl}" class="btn btn-sm btn-primary">Edit</a>
                                        <form action="${deleteUrl}" method="post" class="d-inline">
                                            <input type="hidden" name="__RequestVerificationToken" value="${token}" />
                                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this book?');">Delete</button>
                                        </form>
                                    </div>
                                `;
                                container.appendChild(row);
                            });
                            hasMorePages = data.hasNextPage;
                            currentPage++;
                        } else {
                            hasMorePages = false;
                        }
                        isLoading = false;
                        loadingIndicator.style.display = 'none';
                    })
                    .catch(error => {
                        console.error('Error loading books:', error);
                        isLoading = false;
                        loadingIndicator.style.display = 'none';
                    });
            }
            window.addEventListener('scroll', function() {
                if (window.innerHeight + window.scrollY >= document.body.offsetHeight - 1000) {
                    loadBooks();
                }
            });
            if (container.children.length < pageSize) {
                hasMorePages = false;
            } else {
                loadBooks();
            }
            function escapeHtml(text) {
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }
            function formatCurrency(value) {
                return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(value);
            }
        })();
    </script>
}