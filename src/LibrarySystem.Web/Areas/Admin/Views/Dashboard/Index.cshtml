@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="mb-4">
    <div class="report-header">
        <div>
            <h1 class="page-title mb-1">Admin dashboard</h1>
            <p class="page-subtitle mb-0">
                Quick access to the tools you use most: books, readers, rentals and insights.
            </p>
        </div>
        <div class="report-toolbar">
            <a asp-area="Admin" asp-controller="Reports" asp-action="Index" class="btn btn-outline-primary btn-sm">
                View reports
            </a>
        </div>
    </div>
    <div class="row g-3">
        <div class="col-md-6">
            <div class="hero-card">
                <div class="hero-card__blur"></div>
                <div class="hero-card__content">
                    <div class="hero-card__badge">
                        <span>Today at a glance</span>
                    </div>
                    <h2 class="hero-card__title mb-2">Keep your library calm and under control.</h2>
                    <p class="mb-3">
                        Track active rentals, check overdue books and jump straight into the areas
                        that need your attention.
                    </p>
                    <div class="d-flex flex-wrap gap-2">
                        <a asp-area="Admin" asp-controller="Rentals" asp-action="Index" class="btn btn-primary btn-sm">
                            Manage rentals
                        </a>
                        <a asp-area="Admin" asp-controller="Readers" asp-action="Index" class="btn btn-outline-primary btn-sm">
                            View readers
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="quick-links-grid">
                <a asp-area="Admin" asp-controller="Books" asp-action="Index" class="text-decoration-none text-reset">
                    <div class="quick-link-card">
                        <div>
                            <span>Books</span>
                            <small>Catalog, inventory & categories</small>
                        </div>
                        <div class="quick-link-card__icon">📚</div>
                    </div>
                </a>
                <a asp-area="Admin" asp-controller="Rentals" asp-action="Index" class="text-decoration-none text-reset">
                    <div class="quick-link-card">
                        <div>
                            <span>Rentals</span>
                            <small>Check-outs, returns & fines</small>
                        </div>
                        <div class="quick-link-card__icon">📖</div>
                    </div>
                </a>
                <a asp-area="Admin" asp-controller="Reports" asp-action="Index" class="text-decoration-none text-reset">
                    <div class="quick-link-card">
                        <div>
                            <span>Reports</span>
                            <small>Overdue, inventory & revenue</small>
                        </div>
                        <div class="quick-link-card__icon">📊</div>
                    </div>
                </a>
                <a asp-area="Admin" asp-controller="Readers" asp-action="Index" class="text-decoration-none text-reset">
                    <div class="quick-link-card">
                        <div>
                            <span>Readers</span>
                            <small>Members and contact details</small>
                        </div>
                        <div class="quick-link-card__icon">👥</div>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>