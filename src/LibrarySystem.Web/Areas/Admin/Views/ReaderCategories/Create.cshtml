@model LibrarySystem.Application.Features.ReaderCategories.Commands.CreateReaderCategory.CreateReaderCategoryCommand
@{
    ViewData["Title"] = "Create Reader Category";
}
<div class="page-header">
    <h1 class="page-title">Create Reader Category</h1>
</div>
<div class="form-card">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="Name" class="form-label">Category Name</label>
            <input asp-for="Name" class="form-control" placeholder="e.g., Premium, VIP, Student" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="DiscountPercentage" class="form-label">Discount Percentage</label>
            <div class="input-group">
                <input asp-for="DiscountPercentage" class="form-control" type="number" step="0.1" min="0" max="100" placeholder="0.0" />
                <span class="input-group-text">%</span>
            </div>
            <small class="form-text text-muted">Enter a value between 0 and 100. This discount will be applied to rental costs for readers in this category.</small>
            <span asp-validation-for="DiscountPercentage" class="text-danger"></span>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Create Category</button>
            <a asp-action="Index" class="btn btn-outline-primary">Cancel</a>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}