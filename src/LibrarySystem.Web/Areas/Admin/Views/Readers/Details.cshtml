@model LibrarySystem.Application.Features.Readers.Dtos.ReaderDto
@using LibrarySystem.Application.Features.Rentals.Dtos
@using LibrarySystem.Application.Features.RentalRequests.Dtos
@using LibrarySystem.Domain.Enums
@{
    ViewData["Title"] = "Reader Details";
    var rentals = ViewBag.Rentals as List<RentalTransactionDto> ?? new List<RentalTransactionDto>();
    var pendingRequests = ViewBag.PendingRentalRequests as List<RentalRequestDto> ?? new List<RentalRequestDto>();
}
<div class="page-header">
    <h1 class="page-title">Reader Details</h1>
</div>
<div class="form-card">
    <dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Name</dd>
    <dt class="col-sm-2">Address</dt>
    <dd class="col-sm-10">@Model.Address</dd>
    <dt class="col-sm-2">Phone</dt>
        <dd class="col-sm-10">@Model.Phone</dd>
    </dl>
    <div class="d-flex gap-2 mt-4">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
        <a asp-action="Index" class="btn btn-outline-primary">Back to List</a>
    </div>
</div>
@if (User.IsInRole("Admin") && rentals.Any())
{
    <div class="form-card mt-4">
        <h5 class="section-title mb-3">Rental History</h5>
        <div class="table-responsive">
            <table class="table table-modern mb-0">
                <thead>
                    <tr>
                        <th>Book</th>
                        <th>Issue Date</th>
                        <th>Expected Return</th>
                        <th>Actual Return</th>
                        <th>Status</th>
                        <th>Final Cost</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rental in rentals)
                    {
                        <tr>
                            <td>@(rental.BookTitle ?? "N/A")</td>
                            <td>@rental.IssueDate.ToShortDateString()</td>
                            <td>@rental.ExpectedReturnDate.ToShortDateString()</td>
                            <td>@(rental.ActualReturnDate?.ToShortDateString() ?? "-")</td>
                            <td>
                                <span class="badge @(rental.Status == RentalStatus.Active ? "bg-success" : "bg-secondary")">@rental.Status</span>
                            </td>
                            <td>@rental.FinalRentalCost.ToString("C")</td>
                            <td>
                                <a asp-area="Admin" asp-controller="Rentals" asp-action="Details" asp-route-id="@rental.Id" class="btn btn-sm btn-secondary">Details</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
@if (User.IsInRole("Admin") && pendingRequests.Any())
{
    <div class="form-card mt-4">
        <h5 class="section-title mb-3">Pending Rental Requests</h5>
        <div class="table-responsive">
            <table class="table table-modern mb-0">
                <thead>
                    <tr>
                        <th>Book</th>
                        <th>Request Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in pendingRequests)
                    {
                        <tr>
                            <td>
                                <a asp-area="Admin" asp-controller="Books" asp-action="Details" asp-route-id="@request.BookId">@request.BookTitle</a>
                            </td>
                            <td>@request.RequestDate.ToShortDateString()</td>
                            <td>
                                <a asp-area="Admin" asp-controller="RentalRequests" asp-action="Details" asp-route-id="@request.Id" class="btn btn-sm btn-secondary">Details</a>
                                <a asp-area="Admin" asp-controller="RentalRequests" asp-action="Approve" asp-route-id="@request.Id" class="btn btn-sm btn-success">Approve</a>
                                <a asp-area="Admin" asp-controller="RentalRequests" asp-action="Deny" asp-route-id="@request.Id" class="btn btn-sm btn-danger">Deny</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}