@model LibrarySystem.Application.Features.RentalRequests.Commands.ApproveRentalRequest.ApproveRentalRequestCommand
@{
    ViewData["Title"] = "Approve Rental Request";
}
<div class="page-header">
    <h1 class="page-title">Approve Rental Request</h1>
</div>
<div class="form-card">
    <form asp-action="Approve" method="post">
        <input type="hidden" asp-for="RentalRequestId" />
        <input type="hidden" asp-for="ProcessedByUserId" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="ExpectedReturnDate" class="form-label">Expected Return Date</label>
            <input asp-for="ExpectedReturnDate" class="form-control" type="date" />
            <span asp-validation-for="ExpectedReturnDate" class="text-danger"></span>
            <small class="form-text text-muted">Select the expected return date for this rental.</small>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-success">Approve Request</button>
            <a asp-action="Index" class="btn btn-outline-primary">Cancel</a>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var dateInput = document.querySelector('input[type="date"]');
            var tomorrow = new Date();
            tomorrow.setDate(tomorrow.getDate() + 1);
            dateInput.min = tomorrow.toISOString().split('T')[0];
        });
    </script>
}