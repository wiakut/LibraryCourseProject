@{
    ViewData["Title"] = "Welcome";
}
<div class="hero-card mb-4">
    <div class="hero-card__blur"></div>
    <div class="hero-card__content">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <div class="hero-card__badge">
                    <span>Smart library workspace</span>
                </div>
                <h1 class="hero-card__title">All your readers, books & rentals in one calm place.</h1>
                <p class="mb-3 mb-md-4">
                    Streamline daily library work, keep inventory under control and get instant insights
                    into overdue books, fines and reading trends.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-primary btn-sm">
                        Go to admin dashboard
                    </a>
                    <a asp-area="Portal" asp-controller="Books" asp-action="Index" class="btn btn-outline-light btn-sm">
                        Browse catalog
                    </a>
                </div>
            </div>
            <div class="d-flex flex-column align-items-end gap-2">
                <div class="hero-card__pill">
                    <span class="hero-card__pill-dot"></span>
                    Live view of active rentals & overdue fines
                </div>
            </div>
        </div>
    </div>
</div>
<div class="quick-links-grid">
    <a asp-area="Admin" asp-controller="Books" asp-action="Index" class="text-decoration-none text-reset">
        <div class="quick-link-card">
            <div>
                <span>Manage books</span>
                <small>Catalog, availability & genres</small>
            </div>
            <div class="quick-link-card__icon">
                📚
            </div>
        </div>
    </a>
    <a asp-area="Admin" asp-controller="Readers" asp-action="Index" class="text-decoration-none text-reset">
        <div class="quick-link-card">
            <div>
                <span>Readers</span>
                <small>Profiles, categories & contact</small>
            </div>
            <div class="quick-link-card__icon">
                🪪
            </div>
        </div>
    </a>
    <a asp-area="Admin" asp-controller="Rentals" asp-action="Index" class="text-decoration-none text-reset">
        <div class="quick-link-card">
            <div>
                <span>Rentals</span>
                <small>Current, history & returns</small>
            </div>
            <div class="quick-link-card__icon">
                📄
            </div>
        </div>
    </a>
    <a asp-area="Admin" asp-controller="Reports" asp-action="Index" class="text-decoration-none text-reset">
        <div class="quick-link-card">
            <div>
                <span>Reports</span>
                <small>Inventory, overdue and financials</small>
            </div>
            <div class="quick-link-card__icon">
                📊
            </div>
        </div>
    </a>
</div>